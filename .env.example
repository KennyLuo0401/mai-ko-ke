# 《麥擱假》 environment template / 環境變數範本
# Copy to .env.local. Placeholders only — never commit real secrets.
# 複製為 .env.local。只放占位值，不得提交真實金鑰。
#
# With none of these set the app still runs: identity uses a dev secret, rooms
# live in memory, and analysis uses the deterministic fixture.
# 全部留空也能執行：房間存在記憶體，分析使用固定資料。

# ---------------------------------------------------------------------------
# Identity signing (server-only) / 匿名身分簽章（僅伺服器）
# Required in production. Generate: openssl rand -hex 32
# ---------------------------------------------------------------------------
MKK_SESSION_SECRET=replace-with-a-long-random-string

# Optional hosting passcode (server-only). Empty = open hosting.
MKK_HOST_KEY=

# ---------------------------------------------------------------------------
# Where rooms live / 房間儲存位置
# "memory"   (default) = in-process. No credentials. Lost on restart, and it
#                        does NOT work on serverless — a second instance sees
#                        no rooms. Local development and tests only.
# "supabase"           = Postgres. Required for any deployment.
# ---------------------------------------------------------------------------
MKK_STORE=memory

# ---------------------------------------------------------------------------
# Supabase (required when MKK_STORE=supabase) / Supabase 設定
# Dashboard → Project Settings → API. Apply supabase/migrations/*.sql first.
# The secret key bypasses RLS and must never reach the browser.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Analysis adapter / 分析來源
# "fixture" (default) = deterministic bilingual fixture, no credentials needed.
# "openai"            = live OpenAI Responses API (S2). Requires the keys below.
# S1 gate: keep this on "fixture" until the deterministic flow passes.
# ---------------------------------------------------------------------------
MKK_ANALYSIS_ADAPTER=fixture

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=30000
